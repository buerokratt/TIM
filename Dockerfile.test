FROM eclipse-temurin:21-jdk-alpine
WORKDIR /workspace/app

ARG ID_LOG_VERSION=1.0.0-SNAPSHOT

COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
COPY src src
COPY libs libs

RUN ./mvnw install:install-file -Dfile=libs/id-log-${ID_LOG_VERSION}.jar \
    -DgroupId=ee.ria.commons -DartifactId=id-log -Dversion=${ID_LOG_VERSION} \
    -Dpackaging=jar -DgeneratePom=true

# jwtkeystore.jks is gitignored and normally generated per-developer (see generate-keystore.sh), so
# whatever local copy got COPY'd in above (if any) may have a different password - replace it with one
# matching src/test/resources/application.properties's hardcoded password ("ppjjpp", the same example
# password documented in README.md).
RUN rm -f src/main/resources/jwtkeystore.jks && \
    keytool -genkeypair -alias jwtsign -keyalg RSA -keysize 2048 \
        -keystore src/main/resources/jwtkeystore.jks \
        -dname "CN=, OU=, O=, L=, ST=, C=" -storepass ppjjpp -validity 3650

RUN ./mvnw test jacoco:report
