<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd">

    <changeSet id="20250310170000" author="Alar Floren">
        <sql dbms="postgresql" endDelimiter=";">
            CREATE SCHEMA jwt_whitelist
        </sql>
    </changeSet>

    <changeSet id="20250310170001" author="Alar Floren">
        <createTable schemaName="jwt_whitelist" tableName="whitelist">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_jwtWhitelist"/>
            </column>
            <column name="jwt_hash" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="timestamp">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
